    eventId: 
  - speakerName: "\uB098\uB808\uC774\uC158"
    dialogueText: "\uAD6D\uC655\uC740\u0020\uB9C8\uBC95\uC744\u0020\uC804\uBB38\uC801\uC73C\uB85C\u0020\uBC30\uC6B0\uACE0\u0020\uB2E4\uB8E8\uB294\u0020\uC790\uB4E4\uC744\u0020\uC591\uC131\uD558\uAE30\u0020\uC2DC\uC791\uD588\uACE0\u002C\u0020\uC0AC\uB78C\uB4E4\uC740\u0020\uADF8\uB4E4\uC744\u0020\uB9C8\uBC95\uC0AC\uB77C\u0020\uBD88\uB800\uB2E4\u002E"
