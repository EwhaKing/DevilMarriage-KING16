  - speakerName: "\uB098\uB808\uC774\uC158"
    dialogueText: "\uC544\uC8FC\u0020\uBA3C\u0020\uC61B\uB0A0\u002C\u0020\uC778\uAC04\uB4E4\uC740\u0020\uD48D\uC694\uB85C\uC6B4\u0020\uB545\u0020\uC704\uC5D0\uC11C\u0020\uC11C\uB85C\uB97C\u0020\uB3C4\uC6B0\uBA70\u0020\uD3C9\uD654\uB86D\uAC8C\u0020\uC0B4\uC544\uAC00\uACE0\u0020\uC788\uC5C8\uB2E4\u002E\u0020\uC790\uC5F0\uC740\u0020\uD48D\uC694\uB85C\uC6C0\uC774\u0020\uAC00\uB4DD\uD588\uACE0\u002C\u0020\uB9C8\uC744\uC740\u0020\uC6C3\uC74C\uC18C\uB9AC\uAC00\u0020\uB04A\uC774\uC9C8\u0020\uC54A\uC558\uB2E4\u002E"
