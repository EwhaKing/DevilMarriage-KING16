    expressionId: default
    characterPosition: 1
    backgroundImage: {fileID: 0}
    eventId: 
  - speakerName: "\uB098\uB808\uC774\uC158"
    dialogueText: "\uADF8\uAC83\uC774\u0020\uBC14\uB85C\u0020\uB9C8\uBC95\uC774\uC5C8\uB2E4\u002E"
