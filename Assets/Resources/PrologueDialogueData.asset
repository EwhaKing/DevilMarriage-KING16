    characterPosition: 1
    backgroundImage: {fileID: 0}
    eventId: 
  - speakerName: "\uB098\uB808\uC774\uC158"
    dialogueText: "\uB9C8\uBC95\uC0AC\uB4E4\uC740\u0020\uD798\uC744\u0020\uBAA8\uC544\u0020\uC545\uB9C8\uB4E4\uC744\u0020\uC778\uAC04\uACC4\uC5D0\uC11C\u0020\uBAB0\uC544\uB0C8\uACE0\u002C\u0020\uADF8\uB4E4\uC774\u0020\uB2E4\uC2DC\uB294\u0020\uB3CC\uC544\uC624\uC9C0\u0020\uBABB\uD558\uB3C4\uB85D\u0020\uB9C8\uACC4\uB77C\uB294\u0020\uB2EB\uD78C\u0020\uC138\uACC4\uB85C\u0020\uCD94\uBC29\uD588\uB2E4\u002E"
    characterSprite: {fileID: 0}
    expressionId: default
    characterPosition: 1
    backgroundImage: {fileID: 0}
    eventId: 
  - speakerName: "\uB098\uB808\uC774\uC158"
    dialogueText: "\uADF8\u0020\uD6C4\u002C\u0020\uB9C8\uBC95\uC740\u0020\uC778\uAC04\uC758\u0020\uC0B6\uC5D0\u0020\uAE4A\uC774\u0020\uC2A4\uBA70\uB4E4\uC5C8\uB2E4\u002E\u0020\uBE44\uB97C\u0020\uB0B4\uB9AC\uAC8C\u0020\uD558\uAC70\uB098\u0020\uAC74\uBB3C\uC744\u0020\uC138\uC6B0\uB294\u0020\uAC70\uB300\uD55C\u0020\uB9C8\uBC95\uBD80\uD130\u002C\u0020\uC637\u0020\uC5BC\uB8E9\uC744\u0020\uC9C0\uC6B0\uAC70\uB098\u0020\uD0C8\uBAA8\uB97C\u0020\uCE58\uB8CC\uD558\uB294\u0020\uC0DD\uD65C\u0020\uB9C8\uBC95\uAE4C\uC9C0\u0020\uB2E4\uC591\uD558\uAC8C\u0020\uC4F0\uC774\uAC8C\u0020\uB418\uC5C8\uB2E4\u002E"
