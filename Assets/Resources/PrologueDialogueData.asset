    eventId: 
  - speakerName: "\uB098\uB808\uC774\uC158"
    dialogueText: "\uB9C8\uBC95\uC740\u0020\uD559\uAD50\uC5D0\uC11C\u0020\uAC00\uB974\uCE58\uB294\u0020\uD544\uC218\u0020\uD559\uBB38\uC774\u0020\uB418\uC5C8\uACE0\u002C\u0020\uACE7\u0020\uB9C8\uBC95\uC0AC\uB294\u0020\uC774\u0020\uC2DC\uB300\uC5D0\uC11C\u0020\uAC00\uC7A5\u0020\uCD94\uC559\uBC1B\uB294\u0020\uC9C1\uC5C5\uC774\u0020\uB418\uC5C8\uB2E4\u002E"
