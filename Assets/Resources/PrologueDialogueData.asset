    characterPosition: 1
    backgroundImage: {fileID: 0}
    eventId: 
  - speakerName: "\uB098\uB808\uC774\uC158"
    dialogueText: "\uD0C0\uB77D\uD55C\u0020\uC778\uAC04\uB4E4\uC740\u0020\uC11C\uB85C\uB97C\u0020\uBBF8\uC6CC\uD558\uACE0\u0020\uC758\uC2EC\uD558\uBA70\u0020\uBD88\uD589\uD574\uC84C\uB2E4\u002E\u0020\uADF8\uB9AC\uACE0\u0020\uADF8\u0020\uC0AC\uC545\uD55C\u0020\uC874\uC7AC\uB4E4\uC740\u0020\uC778\uAC04\uB4E4\uC758\u0020\uBD88\uD589\uC744\u0020\uC9C0\uCF1C\uBCF4\uBA70\u0020\uAE30\uBED0\uD588\uB2E4\u002E"
    characterSprite: {fileID: 0}
    expressionId: default
    characterPosition: 1
    backgroundImage: {fileID: 0}
    eventId: 
  - speakerName: "\uB098\uB808\uC774\uC158"
    dialogueText: "\uC774\u0020\uD574\uC545\uC744\u0020\uC9C0\uCF1C\uBCF8\u0020\uC778\uAC04\uB4E4\uC758\u0020\uAD6D\uC655\uC740\u0020\uADF8\uB4E4\uC744\u0020\u0022\uC545\uB9C8\u0022\uB77C\uACE0\u0020\uC774\uB984\u0020\uBD99\uC774\uACE0\u0020\uC545\uB9C8\uB4E4\uC5D0\uAC8C\u0020\uB9DE\uC11C\uAE30\u0020\uC704\uD574\u0020\uC0C8\uB85C\uC6B4\u0020\uD798\uC744\u0020\uAC1C\uBC1C\uD588\uB2E4\u002E"
