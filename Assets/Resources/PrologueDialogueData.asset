  - speakerName: "\uB098\uB808\uC774\uC158"
    dialogueText: "\uD558\uC9C0\uB9CC\u0020\uCD5C\uADFC\u002C\u0020\uB9C8\uACC4\uC640\u0020\uC778\uAC04\uACC4\uB97C\u0020\uAC00\uB974\uB294\u0020\uCC28\uC6D0\uC758\u0020\uACB0\uACC4\uC5D0\u0020\uBBF8\uC138\uD55C\u0020\uADE0\uC5F4\uC774\u0020\uC0DD\uAE30\uAE30\u0020\uC2DC\uC791\uD588\uB2E4\u002E\u0020\uC624\uB798\uC804\u0020\uC545\uB9C8\uB4E4\uC744\u0020\uBD09\uC778\uD55C\u0020\uC774\uD6C4\u0020\uB2E8\u0020\uD55C\u0020\uBC88\uB3C4\u0020\uD754\uB4E4\uB9B0\u0020\uC801\u0020\uC5C6\uB358\u0020\uACB0\uACC4\uC600\uB2E4\u002E"
