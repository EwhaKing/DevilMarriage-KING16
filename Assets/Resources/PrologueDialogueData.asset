  - speakerName: "\uB098\uB808\uC774\uC158"
    dialogueText: "\uADF8\uB807\uAC8C\u0020\uC138\uC0C1\uC740\u0020\uB2E4\uC2DC\u0020\uD3C9\uD654\uB97C\u0020\uB418\uCC3E\uC740\u0020\uB4EF\uD588\uB2E4\u002E\u0020\uC545\uB9C8\uC758\u0020\uC774\uB984\uC740\u0020\uC810\uCC28\u0020\uC624\uB798\uB41C\u0020\uC5ED\uC0AC\u0020\uC18D\u0020\uC774\uC57C\uAE30\uB85C\uB9CC\u0020\uB0A8\uC558\uACE0\u002C\u0020\uC0AC\uB78C\uB4E4\uC740\u0020\uC790\uC2E0\uB4E4\uC774\u0020\uB204\uB9AC\uB294\u0020\uD3C9\uD654\uAC00\u0020\uC601\uC6D0\uD788\u0020\uC774\uC5B4\uC9C8\u0020\uAC83\uC774\uB77C\u0020\uBBFF\uC5C8\uB2E4\u002E"
