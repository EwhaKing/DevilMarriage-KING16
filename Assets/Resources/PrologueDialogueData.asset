  - speakerName: "\uB098\uB808\uC774\uC158"
    dialogueText: "\uADF8\uB7EC\uB358\u0020\uC5B4\uB290\u0020\uB0A0\u002C\u0020\uC815\uCCB4\uBD88\uBA85\uC758\u0020\uBFD4\u0020\uB2EC\uB9B0\u0020\uC874\uC7AC\uB4E4\uC774\u0020\uB098\uD0C0\uB0AC\uB2E4\u002E\u0020\uADF8\uB4E4\uC740\u0020\uC778\uAC04\uC744\u0020\uC720\uD639\uD558\uACE0\u0020\uB9C8\uC74C\uC758\u0020\uC57D\uD55C\u0020\uD2C8\uC744\u0020\uD30C\uACE0\uB4E4\uC5B4\u0020\uC778\uAC04\uC744\u0020\uBFCC\uB9AC\uAE4C\uC9C0\u0020\uD0C0\uB77D\uC2DC\uCF30\uB2E4\u002E"
